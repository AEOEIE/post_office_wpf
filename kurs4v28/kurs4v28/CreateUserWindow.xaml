<Window x:Class="kurs4v28.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs4v28"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CreateUserWindow" Height="480" Width="400" ResizeMode="NoResize">
    <Grid>
        <StackPanel>
            <TextBlock FontSize="20" HorizontalAlignment="Center" Margin="10" FontFamily="Comic Sans MS" x:Name="usHeader">Новый пользователь</TextBlock>
            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Margin="15" Width="130" FontFamily="Comic Sans MS">Имя</TextBlock>
                    <TextBox  Name ="empName_txt" Width="160 px" Height="40" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите имя сотрудника" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="130" FontFamily="Comic Sans MS">Фамилия</TextBlock>
                    <TextBox  Name ="empSurname_txt" Width="160 px" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите фамилию" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="130" FontFamily="Comic Sans MS">Отчество</TextBlock>
                    <TextBox  Name ="empOtchestvo_txt" Width="160 px" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите отчество" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="130" FontFamily="Comic Sans MS">Login</TextBlock>
                    <TextBox  Name ="empLogin_txt" Width="160 px" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите login" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="130" FontFamily="Comic Sans MS">Пароль</TextBlock>
                    <TextBox  Name ="empPassword_txt" Width="160" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите пароль" MaxLength="100"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="130" FontFamily="Comic Sans MS">Поддтвердите пароль</TextBlock>
                    <TextBox  Name ="empPassword1_txt" Width="160" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Подтвердите пароль" MaxLength="100"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="130" FontFamily="Comic Sans MS">Роль пользователя</TextBlock>
                    <!--<TextBox  Name ="empRole_txt" Width="160" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите роль"></TextBox>-->
                    <ComboBox Name ="empRole_txt" FontFamily="Comic Sans MS" Width="160">
                        <ComboBoxItem>admin</ComboBoxItem>
                        <ComboBoxItem>operator</ComboBoxItem>
                        <ComboBoxItem>service_manager</ComboBoxItem>
                        <ComboBoxItem>branch_manager</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Button VerticalAlignment="Bottom" Click="buttonCreateClick" x:Name="Create_btn">Создать</Button>

    </Grid>
</Window>