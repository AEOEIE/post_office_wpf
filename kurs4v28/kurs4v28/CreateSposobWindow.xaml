<Window x:Class="kurs4v28.CreateSposobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs4v28"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CreateSposobWindow" Height="270" Width="400">
    <Grid>
        <StackPanel>
            <TextBlock FontSize="20" HorizontalAlignment="Center" Margin="10" FontFamily="Comic Sans MS" x:Name="servHeader">Новый способ доставки</TextBlock>
            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Margin="15" Width="130" FontFamily="Comic Sans MS">Название</TextBlock>
                    <TextBox  Name ="sposobName_txt" Width="160 px" Height="40" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите название способа" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Margin="15" Width="130" FontFamily="Comic Sans MS">Описание</TextBlock>
                    <TextBox  Name ="sposobOpisanie_txt" Width="160 px" Height="40" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите описание способа" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="130" FontFamily="Comic Sans MS">Цена</TextBlock>
                    <TextBox  Name ="sposobPrice_txt" Width="160 px" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите цену" PreviewTextInput="textBox_PreviewTextInput" MaxLength="8"></TextBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Button VerticalAlignment="Bottom" Click="buttonCreateClick" x:Name="Create_btn">Создать</Button>

    </Grid>
</Window>
