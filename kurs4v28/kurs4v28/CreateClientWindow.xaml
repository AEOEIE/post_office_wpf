<Window x:Class="kurs4v28.CreateClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs4v28"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CreateClientWindow" Height="510" Width="400">
    <Grid>
        <StackPanel>
            <TextBlock FontSize="20" HorizontalAlignment="Center" Margin="10" FontFamily="Comic Sans MS" x:Name="clHeader">Новый клиент</TextBlock>
            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Margin="15" Width="150" FontFamily="Comic Sans MS">Имя</TextBlock>
                    <TextBox  Name ="clName_txt" Width="160 px" Height="40" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите имя клиента" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="150" FontFamily="Comic Sans MS">Фамилия</TextBlock>
                    <TextBox  Name ="clSurname_txt" Width="160 px" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите фамилию" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="150" FontFamily="Comic Sans MS">Отчество</TextBlock>
                    <TextBox  Name ="clOtchestvo_txt" Width="160 px" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите отчество" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="150" FontFamily="Comic Sans MS">Адрес</TextBlock>
                    <TextBox  Name ="clAddress_txt" Width="160 px" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите адрес" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="150" FontFamily="Comic Sans MS">Телефон</TextBlock>
                    <TextBox  Name ="clPhone_txt" Width="160" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите номер телефона" PreviewTextInput="textBox_PreviewTextInput" MaxLength="18"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="150" FontFamily="Comic Sans MS">Серия и номер паспорта</TextBlock>
                    <TextBox  Name ="clPassport_txt" Width="160" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите серию и номер" PreviewTextInput="textBox_PreviewTextInput" MaxLength="11"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="150" FontFamily="Comic Sans MS">Кем выдан паспорт</TextBlock>
                    <TextBox  Name ="clPassportKemVidan_txt" Width="160" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите учреждение" MaxLength="50"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="15"  Width="150" FontFamily="Comic Sans MS">Индекс</TextBlock>
                    <TextBox  Name ="clPostIndex_txt" Width="160" FontSize=" 12" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите почтовый индекс" PreviewTextInput="textBox_PreviewTextInput" MaxLength="6"></TextBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Button VerticalAlignment="Bottom" Click="buttonCreateClick" x:Name="Create_btn">Создать</Button>
    </Grid>
</Window>
