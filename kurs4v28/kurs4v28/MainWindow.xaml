<Window x:Class="kurs4v28.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs4v28"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MainWindow" Height="570" Width="900"  ResizeMode="CanMinimize">
    <Grid Background="#9439ea">
        <StackPanel Width="350" Height="410">
            <Border BorderThickness="1" BorderBrush="#9439ea" CornerRadius="50" Width="350" Height="410" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="Black" ShadowDepth="0" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Label FontSize="40"  Margin="0, 30" FontFamily="Comic Sans MS">Вход</Label>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Click="HelpButton_Click">?</Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Margin="10">
                            <TextBlock Text="Логин" FontSize=" 20" FontFamily="Comic Sans MS"></TextBlock>
                            <TextBox Name ="login_txt" Width="200 px" FontSize=" 15" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:HintAssist.Hint="Введите логин"></TextBox>
                        </StackPanel>
                        <StackPanel Margin="10">
                            <TextBlock Text="Пароль" FontSize="20" FontFamily="Comic Sans MS"></TextBlock>
                            <PasswordBox Name ="password_txt" Width="200 px" FontSize=" 15" FontFamily="Comic Sans MS" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" materialDesign:HintAssist.Hint="Введите пароль"></PasswordBox>
                        </StackPanel>
                        <StackPanel Margin="10,5" HorizontalAlignment="Left">
                            <CheckBox Name="chkRememberMe" FontFamily="Comic Sans MS" FontSize="14" Content="Запомнить меня" Margin="5,0,0,0"/>
                        </StackPanel>
                        <Button Margin="0 20" FontSize="20" Click="Button_voiti_Click" x:Name="Vhod_btn">Войти</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
