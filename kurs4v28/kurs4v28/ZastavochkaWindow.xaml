<Window x:Class="kurs4v28.ZastavochkaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        Height="570" Width="900">

    <Window.Resources>
        <Storyboard x:Key="SceneAnimation">
            <DoubleAnimation Storyboard.TargetName="Scene1"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.3"
                           BeginTime="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="Scene2"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.2"
                           BeginTime="0:0:1.1"/>
            <DoubleAnimation Storyboard.TargetName="Scene2"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.2"
                           BeginTime="0:0:2"/>
            <DoubleAnimation Storyboard.TargetName="Scene3"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.2"
                           BeginTime="0:0:2"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Scene1" Background="White">
            <Image x:Name="PostImage" Stretch="Uniform" Opacity="0.9"/>
        </Grid>
        <Grid x:Name="Scene2" Opacity="0" Background="White">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Система учета услуг" 
                          FontFamily="Comic Sans MS" 
                          FontSize="36" 
                          FontWeight="Bold"
                          Foreground="#9439ea"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="Scene3" Opacity="0" Background="#9439ea">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Для почтового отделения" 
                          FontFamily="Comic Sans MS" 
                          FontSize="36" 
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>